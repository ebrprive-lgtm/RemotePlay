<Window x:Class="RemotePlay.VideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemotePlay.VideoPlayer"
        mc:Ignorable="d"
        Title="RemotePlay Video Player" 
        Height="450" 
        Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        Topmost="True"
        Background="Black"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <!-- VideoView created in code-behind to avoid XAML parse-time VLC native library dependency -->
    <Grid x:Name="VideoHost" Background="Black" />
</Window>
