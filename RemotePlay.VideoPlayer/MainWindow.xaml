<Window x:Class="RemotePlay.VideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemotePlay.VideoPlayer"
        mc:Ignorable="d"
        Title="RemotePlay Video Player" 
        Height="450" 
        Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        Topmost="True"
        Background="Black"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        Deactivated="Window_Deactivated">
    <!-- VideoView created in code-behind to avoid XAML parse-time VLC native library dependency -->
    <Grid x:Name="VideoHost" Background="Black" ClipToBounds="True">
        <Popup x:Name="PlaybackControlsPopup"
               AllowsTransparency="True"
               Focusable="False"
               Placement="Custom"
               StaysOpen="True">
            <Border x:Name="PlaybackControls"
                HorizontalAlignment="Stretch"
                Padding="22,14,22,12"
                Background="#66000000"
                BorderBrush="#66FFFFFF"
                BorderThickness="3"
                CornerRadius="14"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Slider x:Name="SeekSlider"
                        Grid.Row="0"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        Height="42"
                        IsMoveToPointEnabled="True"
                        IsEnabled="False"
                        ValueChanged="SeekSlider_ValueChanged">
                    <Slider.Template>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid Height="42">
                                <Track x:Name="PART_Track"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       Orientation="Horizontal"
                                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                       VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Center">
                                            <Border Height="8" Background="#E94560" CornerRadius="4"/>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Center">
                                            <Border Height="8" Background="#66FFFFFF" CornerRadius="4"/>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="24" Height="24" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Ellipse Fill="White" Stroke="#E94560" StrokeThickness="3"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>

                <DockPanel Grid.Row="1" LastChildFill="False" Margin="2,6,0,0">
                    <Button x:Name="PreviousVideoButton"
                            DockPanel.Dock="Left"
                            Content="&#xE892;"
                            Width="44"
                            Height="42"
                            Margin="0,0,6,0"
                            Padding="0"
                            Background="#333333"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            ToolTip="No previous title"
                            AutomationProperties.Name="Previous video"
                            Click="PreviousVideoButton_Click"/>
                    <Button x:Name="PausePlaybackButton"
                            DockPanel.Dock="Left"
                            Content="&#xE769;"
                            Width="44"
                            Height="42"
                            Margin="0,0,6,0"
                            Padding="0"
                            Background="#E94560"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Pause playback (Space)"
                            AutomationProperties.Name="Pause playback"
                            Click="PausePlaybackButton_Click"/>
                    <Button x:Name="NextVideoButton"
                            DockPanel.Dock="Left"
                            Content="&#xE893;"
                            Width="44"
                            Height="42"
                            Margin="0,0,12,0"
                            Padding="0"
                            Background="#333333"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            ToolTip="No next title"
                            AutomationProperties.Name="Next video"
                            Click="NextVideoButton_Click"/>
                    <Button x:Name="StopPlaybackButton"
                            DockPanel.Dock="Right"
                            Content="&#xE71A;"
                            Width="44"
                            Height="42"
                            Margin="12,0,0,0"
                            Padding="0"
                            Background="#E94560"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Stop playback"
                            AutomationProperties.Name="Stop playback"
                            Click="StopPlaybackButton_Click"/>
                    <Slider x:Name="VolumeSlider"
                            DockPanel.Dock="Right"
                            Width="100"
                            Height="32"
                            Margin="8,0"
                            Minimum="0"
                            Maximum="1"
                            Value="1"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ToolTip="Volume"
                            AutomationProperties.Name="Volume"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <Button x:Name="MuteVolumeButton"
                            DockPanel.Dock="Right"
                            Content="&#xE767;"
                            Width="42"
                            Height="42"
                            Margin="8,0,0,0"
                            Padding="0"
                            Background="#333333"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Mute audio"
                            AutomationProperties.Name="Mute audio"
                            Click="MuteVolumeButton_Click"/>
                    <TextBlock x:Name="PlaybackTimeText"
                               DockPanel.Dock="Left"
                               Text="00:00 / --:--"
                               MinWidth="104"
                               Margin="0,0,8,0"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="PlaybackTimeButton"
                            DockPanel.Dock="Left"
                            Content="&#xE823;"
                            Width="36"
                            Height="42"
                            Padding="0"
                            Margin="0"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            ToolTip="Click to show total duration"
                            AutomationProperties.Name="Toggle time display"
                            AutomationProperties.HelpText="Toggle between remaining time and total duration"
                            Click="PlaybackTimeButton_Click"/>
                </DockPanel>
            </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
