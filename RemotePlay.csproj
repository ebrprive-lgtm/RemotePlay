<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RemotePlay.ico</ApplicationIcon>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
  </PropertyGroup>

  <Target Name="WriteVersionTxt" AfterTargets="Build">
    <WriteLinesToFile File="$(OutputPath)version.txt" Lines="$(Version)" Overwrite="true" />
  </Target>

  <Target Name="WriteVersionTxtOnPublish" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)version.txt" Lines="$(Version)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <Compile Remove="RemotePlay.Tests\**\*.cs" />
    <None Remove="RemotePlay.Tests\**" />
    <Compile Remove="BenchmarkSuite1\**\*.cs" />
    <None Remove="BenchmarkSuite1\**" />
    <Compile Remove="RemotePlay.VideoPlayer\**\*.cs" />
    <Page Remove="RemotePlay.VideoPlayer\**\*.xaml" />
    <ApplicationDefinition Remove="RemotePlay.VideoPlayer\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RemotePlay.ico" />

    <None Remove="remoteplay.json" />

    <Content Include="Assets\Pwa\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="WebAssets\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Link to IPC contracts from VideoPlayer project -->
    <Compile Include="RemotePlay.VideoPlayer\Ipc\IpcContracts.cs">
      <Link>Services\Ipc\IpcContracts.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.*" />
    <PackageReference Include="TagLibSharp" Version="2.*" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\Ipc\" />
  </ItemGroup>

  <Target Name="BuildVideoPlayerForRemotePlay" BeforeTargets="CopyVideoPlayerToBuildOutput;CopyVideoPlayerToPublishOutput" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\RemotePlay.VideoPlayer\RemotePlay.VideoPlayer.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyVideoPlayerToBuildOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_VideoPlayerBuildOutput>$(MSBuildProjectDirectory)\RemotePlay.VideoPlayer\bin\$(Configuration)\net8.0-windows\win-x64</_VideoPlayerBuildOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(_VideoPlayerBuildOutput)\RemotePlay.VideoPlayer.exe')"
           Text="The isolated video player was not built at '$(_VideoPlayerBuildOutput)'. Ensure RemotePlay.VideoPlayer builds successfully." />
    <ItemGroup>
      <_VideoPlayerBuildFiles Include="$(_VideoPlayerBuildOutput)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_VideoPlayerBuildFiles)"
          DestinationFiles="@(_VideoPlayerBuildFiles->'$(TargetDir)RemotePlay.VideoPlayer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVideoPlayerToPublishOutput" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_VideoPlayerBuildOutput>$(MSBuildProjectDirectory)\RemotePlay.VideoPlayer\bin\$(Configuration)\net8.0-windows\win-x64</_VideoPlayerBuildOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(_VideoPlayerBuildOutput)\RemotePlay.VideoPlayer.exe')"
           Text="The isolated video player was not built at '$(_VideoPlayerBuildOutput)'. Ensure RemotePlay.VideoPlayer builds successfully." />
    <ItemGroup>
      <_VideoPlayerPublishFiles Include="$(_VideoPlayerBuildOutput)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_VideoPlayerPublishFiles)"
          DestinationFiles="@(_VideoPlayerPublishFiles->'$(PublishDir)RemotePlay.VideoPlayer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
